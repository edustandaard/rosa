  <children
      xsi:type="archimate:DiagramModelNote"
      id="id-83b4584b1b71482e9451b0cdd7133696"
      targetConnections="id-73928809d53f4bef81d2ae33a883c06f id-f63ee42c13764a168c96852a3c970b64"
      textAlignment="1"
      content="Vraaggestuurd en adaptief onderwijs&#xD;&#xA;--&#xD;&#xA;Er is een vraag naar onderwijs dat beter aansluit op de praktijk, individuele leerbehoeften en veranderende arbeidsmarkt.&#xD;&#xA;">
    <features
        name="deriveElementLineColor"
        value="false"/>
    <bounds
        x="516"
        y="564"
        width="335"
        height="110"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelNote"
      id="id-5ebbb7fda81c455a92528527e8f993ad"
      textAlignment="1"
      content="Deelnemermobiliteit&#xD;&#xA;--&#xD;&#xA;Onderwijsdeelnemers volgen onderwijs bij meerdere aanbieders (bijv. via samenwerkingen, minors, keuzevakken, uitwisseling)">
    <features
        name="deriveElementLineColor"
        value="false"/>
    <bounds
        x="1272"
        y="624"
        width="335"
        height="110"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelNote"
      id="id-cbc20ec7fce646c8afefab83f4863558"
      textAlignment="1"
      content="Flexibilisering van het onderwijs&#xD;&#xA;--&#xD;&#xA;Onderwijsdeelnemers willen meer keuzevrijheid in vorm, inhoud, tempo, moment en plaats van leren. Onderwijsaanbieders spelen daarop in met bijv. flexibele leerroutes en meerdere instroommomenten.">
    <features
        name="deriveElementLineColor"
        value="false"/>
    <bounds
        x="1656"
        y="624"
        width="335"
        height="110"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelNote"
      id="id-2634bddb570e4a23b2461b52db0c85a3"
      targetConnections="id-9d117f30e36949a69acaf53a2b6bae8e id-ff6a49bed51b4de397d701c3e8b25c2c"
      textAlignment="1"
      content="weg? of ophangen aan ontwikkeling zoals curriculum2030 oid.&#xD;&#xA;&#xD;&#xA;Bijdrage aan brede vorming&#xD;&#xA;--&#xD;&#xA;Onderwijs moet niet alleen kennis overdragen, maar ook bijdragen aan 'zachte' leerresultaten zoals burgerschap, duurzaamheid, mediawijsheid, 21st century skills, etc.">
    <features
        name="deriveElementLineColor"
        value="false"/>
    <bounds
        x="516"
        y="744"
        width="335"
        height="157"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelNote"
      id="id-07efb8f7cfd94e91b9d87aef5bb88391"
      textAlignment="1"
      content="Toename van cyberdreigingen&#xD;&#xA;--&#xD;&#xA;Onderwijsaanbieders zijn steeds vaker het doelwit van (gerichte) aanvallen, datalekken en ransomware, spionage. ">
    <features
        name="deriveElementLineColor"
        value="false"/>
    <bounds
        x="1272"
        y="768"
        width="335"
        height="110"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelNote"
      id="id-5aee4dded14a4bf6ba4a39b865918aed"
      textAlignment="1"
      content="Opkomst van (generatieve) AI in het onderwijs&#xD;&#xA;--&#xD;&#xA;Onderwijsdeelnemers en onderwijsprofessionals maken steeds meer gebruik van generatieve AI / LLMs.">
    <features
        name="deriveElementLineColor"
        value="false"/>
    <bounds
        x="1656"
        y="768"
        width="335"
        height="110"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelNote"
      id="id-8dc56d5025ff48df9bdfdc3b0cbdb04a"
      targetConnections="id-779dbdb82fbb417a960c1cf0050fb35e"
      textAlignment="1"
      content="Cloudmigratie&#xD;&#xA;--&#xD;&#xA;Onderwijsaanbieders maken steeds meer gebruik van cloudgebaseerde platforms en SaaS-oplossingen, die onderling met elkaar moeten samenwerken.">
    <features
        name="deriveElementLineColor"
        value="false"/>
    <bounds
        x="876"
        y="900"
        width="335"
        height="110"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelNote"
      id="id-5e2402e0d4ad41a7864ff5ae7dd7391c"
      textAlignment="1"
      content="Archiefwet&#xD;&#xA;--&#xD;&#xA;Stelt eisen aan bewaartermijnen en archivering.">
    <features
        name="deriveElementLineColor"
        value="false"/>
    <bounds
        x="1656"
        y="900"
        width="335"
        height="110"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelNote"
      id="id-41f8d93166ca448f8c4d9b267ad8d1d7"
      textAlignment="1"
      content="Samenwerking tussen onderwijsaanbieders&#xD;&#xA;--&#xD;&#xA;(nieuwe vormen van onderwijs zoals 10-14, passend onderwijs / samenwerkingsverbanden, aansluiting bij regionale (arbeidsmarkt)ontwikkelingen, expertise en specialisatie, vervagen van aanbieder- en sectorgrenzen, invullen van deelnemerbehoeften zoals mobiliteits- en flexibiliseringsbehoeften)">
    <features
        name="deriveElementLineColor"
        value="false"/>
    <bounds
        x="1272"
        y="480"
        width="335"
        height="134"/>
  </children>
